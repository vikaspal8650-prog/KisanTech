# Port used by the Express API
PORT=5000

# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Use an Atlas connection string or local MongoDB, for example mongodb://127.0.0.1:27017/fasal-guru
MONGODB_URI=your_database_connection_string

# Meta WhatsApp Cloud API (server-only)
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v24.0
